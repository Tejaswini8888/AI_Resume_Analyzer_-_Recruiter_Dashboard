# ---------------------------------------------------------------------------
# TalentIQ environment template. Copy to .env and fill in real values.
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
#
# Never commit real secrets. Placeholders only live here.
# ---------------------------------------------------------------------------

# ---- Secrets (no defaults — fill in your own values) ----
GROQ_API_KEY=
# Admin bootstrap: when TALENTIQ_ADMIN_EMAIL is set, registering an account
# with this email + password grants the ADMIN role. Keep it unset in prod
# unless you intend to bootstrap an admin account.
TALENTIQ_ADMIN_EMAIL=
TALENTIQ_ADMIN_PASSWORD=

# ---- Application ----
# development | testing | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Groq model used for all AI calls (summary, analysis, interview, coach).
# A single value — every AI service reads the same centralized setting.
GROQ_MODEL=openai/gpt-oss-120b

# ---- Database ----
# Production-grade override. sqlite:/// file URLs resolve against the project
# root; leave empty to use TALENTIQ_DB_PATH below.
DATABASE_URL=
# SQLite file (relative paths resolve against the project root).
TALENTIQ_DB_PATH=data/talentiq.db

# ---- File security ----
# Max accepted resume size in MB.
MAX_RESUME_SIZE_MB=10
# Comma-separated allowed extensions (dot-prefixed). PDF only by default.
ALLOWED_RESUME_EXTENSIONS=.pdf
# Reserved directories (created on demand; never committed to Git).
UPLOAD_DIRECTORY=data/uploads
TEMP_DIRECTORY=data/tmp

# ---- Recruiter scoring ----
# "Score-Eligible" tag / KPI threshold (0-100). Display-only — never
# automatically shortlists a candidate.
RECRUITER_SCORE_THRESHOLD=60